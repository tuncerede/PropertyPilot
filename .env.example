# PropertyPilot environment variables
#
# Copy this file to `.env` and fill in the values you have.
#   cp .env.example .env
#
# Anything prefixed with EXPO_PUBLIC_ is INLINED INTO THE CLIENT BUNDLE and is
# readable by anyone who downloads the app. Only put values here that are safe
# to be public.
#
# NEVER put any of the following in this file (or any EXPO_PUBLIC_ variable):
#   - Supabase service_role key
#   - RevenueCat secret API key (starts with `sk_`)
#   - App Store Connect / Google Play private keys
#   - Any database connection string

# ---------------------------------------------------------------------------
# App environment
# ---------------------------------------------------------------------------
# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Demo mode runs the whole app against a local, in-device sample portfolio with
# a mock auth session and a mock subscription. No Supabase or RevenueCat
# credentials are required. Set to `false` once real credentials are in place.
EXPO_PUBLIC_DEMO_MODE=true

# When demo mode is on, this controls which entitlement the mock subscription
# service reports. One of: free | pro | investor
EXPO_PUBLIC_DEMO_TIER=pro

# ---------------------------------------------------------------------------
# Supabase (public keys only — the anon key is designed to be public and is
# protected by Row Level Security)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# RevenueCat (public SDK keys only — these are designed to ship in the client)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# RevenueCat offering identifier to display on the paywall.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
